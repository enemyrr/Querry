// Pluk Version Configuration
// This file contains the version and build number for the app

MARKETING_VERSION = 0.0.49
CURRENT_PROJECT_VERSION = 312

// Domain and GitHub configuration
APP_DOMAIN = pluk.sh
GITHUB_URL = https://github.com/pluk-inc/Pluk

// Bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = doc.pluk
DEVELOPMENT_TEAM =

// Official-build service configuration. Local values live in the ignored
// Secrets.xcconfig file; source builds remain functional without it.
POSTHOG_API_KEY =
SENTRY_DSN =
WORKOS_CLIENT_ID_DEBUG =
WORKOS_CLIENT_ID_RELEASE =
CONVEX_OAUTH_CLIENT_ID =
CONVEX_OAUTH_CLIENT_SECRET =
BEDROCK_IDENTITY_POOL_ID =
BEDROCK_ROLE_ARN =

#include? "Secrets.xcconfig"

WORKOS_CLIENT_ID[config=Debug] = $(WORKOS_CLIENT_ID_DEBUG)
WORKOS_CLIENT_ID[config=Release] = $(WORKOS_CLIENT_ID_RELEASE)
