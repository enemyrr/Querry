// Copy this file to Secrets.xcconfig and supply values for official builds.
// Secrets.xcconfig is ignored by Git. These values are embedded in the built
// app and should not be treated as server-side secrets.

POSTHOG_API_KEY =
// Escape https:// as https:/$()/ so xcconfig does not treat // as a comment.
SENTRY_DSN =
CONVEX_OAUTH_CLIENT_ID =
CONVEX_OAUTH_CLIENT_SECRET =

// Optional signing override for official builds.
DEVELOPMENT_TEAM =
